import acton.rts
import testing
import hpack

def _headers(k: int) -> dict[str, str]:
    return {
        ":method": "GET",
        ":path": "/index.html",
        "user-agent": "acton-test",
        "x-request": str(k),
    }

_FILLER = "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz"

def _churn_headers(k: int) -> dict[str, str]:
    # Block k repeats four headers of block k - 1, which the encoder sends as
    # indexes into the dynamic table, and adds four new ones. Each new entry
    # takes about 100 of the table's 4096 bytes, so from about the tenth block
    # on every block evicts the four oldest entries.
    headers = {":method": "GET", ":path": "/churn/" + str(k)}
    for i in range(4 * k - 4, 4 * k + 4):
        headers["x-churn-" + str(i % 32)] = str(i) + "." + _FILLER
    return headers

proc def _test_tables_churn_across_collections(t: testing.SyncT):
    """A Deflater and Inflater pair keeps its dynamic tables while they fill,
    evict and refill across many collections"""
    # The write-barrier checker of acton test --gc-check makes this take
    # close to the default timeout
    t.timeout(30.0)
    deflater = hpack.Deflater()
    inflater = hpack.Inflater()
    for k in range(20000):
        headers = _churn_headers(k)
        testing.assertEqual(inflater.inflate(deflater.deflate(headers)), headers)

def _test_many_inflaters():
    """Each new Inflater decodes the first header block of a connection"""
    block = hpack.Deflater().deflate(_headers(0))
    for k in range(10000):
        inflater = hpack.Inflater()
        testing.assertEqual(inflater.inflate(block), _headers(0))

actor _test_inflater_keeps_state_across_gc(t: testing.EnvT):
    """An Inflater keeps its dynamic table across collections"""
    deflater = hpack.Deflater()
    inflater = hpack.Inflater()
    try:
        for k in range(20):
            acton.rts.gc(t.env.syscap)
            # Later blocks refer to entries that earlier blocks added
            testing.assertEqual(inflater.inflate(deflater.deflate(_headers(k))), _headers(k))
        t.success()
    except Exception as e:
        t.failure(e)

actor _test_dropped_inflaters_release_memory(t: testing.EnvT):
    """Inflaters that are no longer referenced keep no memory outside the
    collector's heap"""
    cap = t.env.syscap
    block = hpack.Deflater().deflate(_headers(0))

    def decode(n: int):
        for k in range(n):
            hpack.Inflater().inflate(block)

    def outside_gc_heap() -> int:
        # Resident memory minus the part of the collector's heap that is
        # mapped, so that the size of the heap does not count
        acton.rts.gc(cap)
        info = acton.rts.get_gc_info(cap)
        return int(acton.rts.get_rss(cap)) - int(info.heap_size - info.unmapped_bytes)

    decode(1000)
    mem_start = outside_gc_heap()
    decode(100000)
    growth = outside_gc_heap() - mem_start
    if growth < 32 * 1024 * 1024:
        t.success()
    else:
        t.failure(AssertionError("Memory outside the GC heap grew by " + str(growth) + " bytes over 100000 dropped Inflaters"))
